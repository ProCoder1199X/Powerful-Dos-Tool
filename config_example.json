{
  "metadata": {
    "version": "2.0",
    "description": "EWLT Configuration Example",
    "warning": "Only use for authorized testing!"
  },
  
  "test_profiles": {
    "light_test": {
      "users": 10,
      "spawn_rate": 2,
      "duration": 30,
      "description": "Minimal load for initial testing"
    },
    
    "moderate_test": {
      "users": 50,
      "spawn_rate": 5,
      "duration": 120,
      "description": "Standard load test"
    },
    
    "heavy_test": {
      "users": 200,
      "spawn_rate": 10,
      "duration": 300,
      "description": "Stress test for production readiness"
    },
    
    "stress_test": {
      "users": 500,
      "spawn_rate": 25,
      "duration": 600,
      "description": "Maximum load - use carefully!"
    }
  },
  
  "anonymity_presets": {
    "none": {
      "use_tor": false,
      "vpn_proxy": null,
      "mac_spoofing": false,
      "description": "Direct connection (fastest, no anonymity)"
    },
    
    "basic": {
      "use_tor": true,
      "vpn_proxy": null,
      "mac_spoofing": false,
      "identity_rotation": 0,
      "description": "Tor only"
    },
    
    "enhanced": {
      "use_tor": true,
      "vpn_proxy": null,
      "mac_spoofing": true,
      "mac_interface": "wlan0",
      "identity_rotation": 120,
      "description": "Tor + MAC spoofing + identity rotation"
    },
    
    "maximum": {
      "use_tor": true,
      "vpn_proxy": "socks5://localhost:1080",
      "mac_spoofing": true,
      "mac_interface": "eth0",
      "identity_rotation": 60,
      "check_dns_leak": true,
      "description": "VPN + Tor + MAC spoofing (slowest, maximum anonymity)"
    }
  },
  
  "target_configurations": {
    "localhost_dev": {
      "target_url": "http://localhost:8080",
      "target_paths": ["/", "/api/status", "/health"],
      "post_data": null,
      "description": "Local development server"
    },
    
    "staging_environment": {
      "target_url": "https://staging.yoursite.com",
      "target_paths": [
        "/",
        "/about",
        "/products",
        "/api/v1/data"
      ],
      "post_data": null,
      "description": "Staging environment"
    },
    
    "form_testing": {
      "target_url": "https://yoursite.com/login",
      "target_paths": ["/login"],
      "post_data": "username=testuser&password=testpass123",
      "description": "Login form load testing"
    }
  },
  
  "network_interfaces": {
    "linux": {
      "ethernet": "eth0",
      "wireless": "wlan0",
      "virtual": "virbr0"
    },
    
    "macos": {
      "ethernet": "en0",
      "wireless": "en1",
      "thunderbolt": "en5"
    },
    
    "windows": {
      "ethernet": "Ethernet",
      "wireless": "Wi-Fi",
      "note": "Use exact adapter name from 'ipconfig /all'"
    }
  },
  
  "tor_settings": {
    "socks_port": 9050,
    "control_port": 9051,
    "bootstrap_timeout": 30,
    "circuit_timeout": 60,
    "notes": [
      "Default Tor SOCKS port is 9050",
      "Control port 9051 used for identity rotation",
      "Increase timeouts on slow connections"
    ]
  },
  
  "vpn_examples": {
    "note": "These are example formats only",
    "local_socks5": "socks5://localhost:1080",
    "remote_socks5": "socks5://vpn.server.com:1080",
    "authenticated": "socks5://username:password@proxy.server.com:1080",
    "http_proxy": "http://proxy.server.com:8080"
  },
  
  "safety_limits": {
    "max_users": 1000,
    "max_spawn_rate": 100,
    "recommended_start": {
      "users": 10,
      "spawn_rate": 2,
      "duration": 30,
      "note": "Start small, increase gradually"
    }
  },
  
  "best_practices": [
    "Always start with dry-run mode to verify configuration",
    "Begin with minimal load and increase gradually",
    "Monitor server resources during testing",
    "Use anonymity features only when necessary",
    "Test during off-peak hours to avoid affecting real users",
    "Have a kill switch ready (Ctrl+C) if server struggles",
    "Never test production without approval",
    "Document all tests and results",
    "Review logs after each test",
    "Keep test duration short initially"
  ],
  
  "example_commands": {
    "basic_test": "python web_load_tester.py --target-url http://localhost:8080 --users 50",
    
    "dry_run": "python web_load_tester.py --target-url http://localhost --dry-run",
    
    "with_tor": "python web_load_tester.py --target-url https://yoursite.com --users 100 --use-tor",
    
    "full_anonymity": "sudo python web_load_tester.py --target-url https://yoursite.com --users 100 --use-tor --mac-interface wlan0 --identity-rotation 60",
    
    "multi_path": "python web_load_tester.py --target-url https://yoursite.com --target-paths /,/about,/contact --users 75",
    
    "form_test": "python web_load_tester.py --target-url https://yoursite.com/api --post-data 'key=value&test=data' --users 30"
  },
  
  "troubleshooting": {
    "connection_errors": {
      "symptom": "Many failed requests",
      "solutions": [
        "Reduce number of users",
        "Decrease spawn rate",
        "Check if target server is accessible",
        "Verify firewall settings",
        "Increase server resources"
      ]
    },
    
    "tor_issues": {
      "symptom": "Tor fails to start or connect",
      "solutions": [
        "Check if Tor is installed: tor --version",
        "Verify Tor service is running",
        "Check firewall isn't blocking Tor",
        "Wait longer for Tor bootstrap (30-60s)",
        "Try restarting Tor service"
      ]
    },
    
    "mac_spoofing_fails": {
      "symptom": "MAC spoofing error messages",
      "solutions": [
        "Run with sudo/administrator privileges",
        "Verify correct interface name",
        "Check if interface is up",
        "Install required tools (iproute2 on Linux)",
        "Disconnect from network before spoofing"
      ]
    },
    
    "slow_performance": {
      "symptom": "Test runs very slowly",
      "solutions": [
        "Disable Tor if not needed for anonymity",
        "Reduce number of concurrent users",
        "Check your internet connection",
        "Use wired connection instead of WiFi",
        "Close other bandwidth-intensive applications"
      ]
    }
  },
  
  "security_checklist": [
    "[ ] Using on authorized target only",
    "[ ] Have written permission if not your own system",
    "[ ] Started with small load (10-20 users)",
    "[ ] Monitoring server resources",
    "[ ] Using VM for maximum safety",
    "[ ] Logs are stored securely",
    "[ ] Ready to stop test immediately if issues arise",
    "[ ] Documented test purpose and scope",
    "[ ] Notified relevant stakeholders",
    "[ ] Have backup plan if server goes down"
  ]
}
